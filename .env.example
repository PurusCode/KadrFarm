# Основной провайдер — MWS GPT Model Hub (творческие проходы: сценарий/режиссура/критик).
# gpt-oss-120b — оптимум цена/качество; ночной тариф 01:00–07:00 МСК дешевле на ~30%.
LLM_PRIMARY_BASE_URL=https://gpt.mwsapis.ru/projects/project-alexsapan/openai/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=video-farm-gpt-oss-120b-test
# Альтернативы (сильнее, дороже):
#LLM_PRIMARY_MODEL=video-farm-gemma-4-31b-test
#LLM_PRIMARY_MODEL=video-farm-qwen-36-35b-test

# Резерв — локальная Ollama, ТОЛЬКО технические/детерминированные задачи.
LLM_SECONDARY_BASE_URL=http://localhost:11434/v1
LLM_SECONDARY_API_KEY=ollama
LLM_SECONDARY_MODEL=qwen2.5:14b-instruct

LLM_PRIMARY_TIMEOUT_SECONDS=120
LLM_SECONDARY_TIMEOUT_SECONDS=900
# Креатив больше не уходит на слабую локальную модель:
SEMANTIC_VISUAL_PLANNER_PROVIDER=primary
DIRECTOR_CRITIC_PROVIDER=primary
# 1 = старое поведение (критик блокирует прогон), 0 = нерешённое -> human-queue:
KADR_STRICT_CRITIC=0

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_API_KEY_2=

# Стоки (бесплатные ключи)
PIXABAY_API_KEY=
#PEXELS_API_KEY=

# Озвучка: быстрее и живее, чем 0.9
TTS_ENGINE=kokoro
TTS_LANGUAGE=ru
TTS_SPEAKER=dima
TTS_SPEED=1.0
KOKORO_THREADS=2

# Ритм монтажа
KADR_PAUSE_SECONDS=0.22
KADR_PUNCHLINE_PAUSE=0.18

# Звук: локальные CC0-паки (положи туда wav/mp3/ogg; модуль сам конвертирует в 24k mono)
KADR_MUSIC_DIR=D:\KadrFarm\data\audio\music
KADR_SFX_DIR=D:\KadrFarm\data\audio\sfx
# KADR_MUSIC_DIR=data/audio/music
# KADR_SFX_DIR=data/audio/sfx
KADR_AUDIO_CACHE=data/audio/.cache
KADR_MUSIC_LEVEL=0.16
KADR_DUCK_DEPTH=0.75

# Сборка видео
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=25
VIDEO_BITRATE=4500k
VIDEO_GOP=50